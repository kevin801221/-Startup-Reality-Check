# ── AI（Google AI Studio — Gemini API）────────────────────────
# @ai-sdk/google 預設讀此變數；於 https://aistudio.google.com/apikey 取得
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Supabase（Auth + Postgres）────────────────────────────────
# 於 Supabase 專案 Settings → API 取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅 server 端使用，切勿外洩 / 不可加 NEXT_PUBLIC 前綴
SUPABASE_SERVICE_ROLE_KEY=

# ── Drizzle（Postgres 連線字串）───────────────────────────────
# Supabase Settings → Database → Connection string（建議用 pooler / port 6543）
DATABASE_URL=
